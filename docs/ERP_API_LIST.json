{
  "title": "Hamody ERP Integration API",
  "style": "Zoho Inventory–style attribute documentation",
  "documentation": "docs/ERP_INTEGRATION_API.md",
  "baseUrl": "https://www.hamody.com",
  "apiRoot": "https://www.hamody.com/api/erp",
  "lastUpdated": "2026-11-09",
  "headers": {
    "x-erp-key": {
      "type": "string",
      "required": true,
      "description": "Server-to-server key matching env ERP_API_KEY",
      "example": "<ERP_API_KEY>"
    },
    "Authorization": {
      "type": "string",
      "required": "on accepted stock",
      "description": "Bearer <staff token from /api/erp/staff/session>",
      "example": "Bearer eyJhbG…"
    },
    "Content-Type": {
      "type": "string",
      "required": "on POST",
      "example": "application/json"
    }
  },
  "resources": [
    {
      "name": "Products",
      "overview": "Load the catalog that staff can monitor",
      "endpoints": [
        {
          "operation": "List products",
          "method": "GET",
          "path": "/api/erp/products",
          "required": true,
          "auth": ["x-erp-key"],
          "queryParameters": {
            "sku": { "type": "string", "description": "Exact SKU filter" },
            "active": { "type": "boolean", "description": "Filter by active flag" },
            "q": { "type": "string", "description": "Search name or SKU" },
            "limit": { "type": "number", "description": "Page size, default 100, max 500" },
            "cursor": { "type": "string", "description": "Next-page token" },
            "updatedSince": { "type": "string", "description": "ISO-8601 changed since" }
          },
          "attributes": {
            "sku": { "type": "string", "description": "Stock keeping unit", "example": "PDSB1062BU" },
            "productName": { "type": "string", "description": "English product name", "example": "Fitness Band 2 Straps Included Soft Silicone" },
            "category": { "type": "string", "description": "Primary category name", "example": "Fitness Trackers" },
            "active": { "type": "boolean", "description": "Sellable / not archived", "example": true },
            "imageUrl": { "type": "string|null", "description": "Image if the website has one", "example": "https://www.hamody.com/.../product.jpg" }
          }
        }
      ]
    },
    {
      "name": "Stock balances",
      "overview": "Below-20 check. Same SKU at Sharjah and Dubai are two balances. available excludes reserved, damaged, incoming PO.",
      "endpoints": [
        {
          "operation": "List stock balances",
          "method": "GET",
          "path": "/api/erp/stock",
          "required": true,
          "auth": ["x-erp-key"],
          "queryParameters": {
            "sku": { "type": "string" },
            "locationCode": { "type": "string", "example": "SHJ_FULFILMENT" },
            "below": { "type": "number", "description": "Only available < value", "example": 20 },
            "limit": { "type": "number" },
            "cursor": { "type": "string" },
            "updatedSince": { "type": "string" }
          },
          "attributes": {
            "sku": { "type": "string", "example": "PDSB1062BU" },
            "locationCode": { "type": "string", "example": "SHJ_FULFILMENT" },
            "available": { "type": "number", "description": "Sellable units now", "example": 18 },
            "updatedAt": { "type": "string", "description": "ISO-8601 UTC", "example": "2026-11-09T08:15:22.000Z" }
          }
        }
      ]
    },
    {
      "name": "Stock events",
      "overview": "Website or app sale/return so ERP updates without refresh",
      "endpoints": [
        {
          "operation": "Create a stock event",
          "method": "POST",
          "path": "/api/erp/stock/events",
          "required": true,
          "auth": ["x-erp-key"],
          "idempotency": "eventId",
          "attributes": {
            "eventId": { "type": "string", "required": true, "description": "Unique; apply once", "example": "evt_ord_A1B2C3_line_1_sale" },
            "sku": { "type": "string", "required": true, "example": "PDSB1062BU" },
            "locationCode": { "type": "string", "required": true, "example": "SHJ_FULFILMENT" },
            "available": { "type": "number", "required": true, "description": "New available quantity after change", "example": 17 },
            "reason": { "type": "string", "required": true, "enum": ["sale", "return", "adjustment"], "example": "sale" },
            "occurredAt": { "type": "string", "required": false, "example": "2026-11-09T08:20:00.000Z" },
            "orderId": { "type": "string", "required": false },
            "quantityDelta": { "type": "number", "required": false, "example": -1 }
          }
        }
      ]
    },
    {
      "name": "Accepted stock",
      "overview": "After verifier accepts delivery. Rejected/damaged not sent. Same receiptNumber does not add twice.",
      "endpoints": [
        {
          "operation": "Add accepted stock",
          "method": "POST",
          "path": "/api/erp/stock/accepted",
          "required": true,
          "auth": ["x-erp-key", "Authorization Bearer"],
          "idempotency": "receiptNumber",
          "attributes": {
            "sku": { "type": "string", "required": true, "example": "ST4003" },
            "locationCode": { "type": "string", "required": true, "example": "SHJ_FULFILMENT" },
            "acceptedQuantity": { "type": "number", "required": true, "description": "Integer > 0", "example": 40 },
            "receiptNumber": { "type": "string", "required": true, "example": "GRN-2026-00412" },
            "purchaseOrderNumber": { "type": "string", "required": true, "example": "PO-2026-0088" }
          }
        }
      ]
    },
    {
      "name": "Locations",
      "overview": "Warehouse code and name so Sharjah/Dubai match the website",
      "endpoints": [
        {
          "operation": "List locations",
          "method": "GET",
          "path": "/api/erp/locations",
          "required": false,
          "auth": ["x-erp-key"],
          "attributes": {
            "locationCode": { "type": "string", "example": "SHJ_FULFILMENT" },
            "name": { "type": "string", "example": "Sharjah fulfilment" },
            "active": { "type": "boolean", "example": true }
          }
        }
      ]
    },
    {
      "name": "Staff session",
      "overview": "Replace pilot passwords",
      "endpoints": [
        {
          "operation": "Create staff session",
          "method": "POST",
          "path": "/api/erp/staff/session",
          "required": false,
          "auth": [],
          "requestAttributes": {
            "email": { "type": "string", "required": true },
            "password": { "type": "string", "required": true }
          },
          "staffAttributes": {
            "id": { "type": "string", "example": "uid_abc123" },
            "name": { "type": "string", "example": "Sara Al Blooshi" },
            "email": { "type": "string", "example": "verifier@hamody.com" },
            "role": {
              "type": "string",
              "enum": ["Manager", "Accounts", "Procurement", "Receiving", "Verifier", "Admin", "Management"]
            }
          }
        }
      ]
    }
  ],
  "notHamodyApis": [
    "Manager and Accounts approval",
    "Purchase orders and supplier prices",
    "Goods receipts and receiver cannot verify own delivery",
    "Email and WhatsApp links to ERP records"
  ],
  "exampleLocations": [
    { "locationCode": "SHJ_FULFILMENT", "name": "Sharjah fulfilment" },
    { "locationCode": "DXB_STAGING", "name": "Dubai staging" }
  ]
}
